    "postgres": "^3.4.0",
    "viem": "^2.35.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.3.16",
    "@types/node": "^22.0.0",
    "drizzle-kit": "^0.31.11",
