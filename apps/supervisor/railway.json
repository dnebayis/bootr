{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "apps/supervisor/Dockerfile",
    "watchPatterns": [
      "/apps/supervisor/**",
      "/apps/inference/**",
      "/packages/agent-core/**",
      "/packages/shared/**",
      "/package.json",
      "/pnpm-lock.yaml",
      "/pnpm-workspace.yaml",
      "/tsconfig.base.json",
      "/.dockerignore"
    ]
  },
  "deploy": {
    "startCommand": "node dist/index.js",
    "preDeployCommand": [
      "node dist/db/migrate.js"
    ],
    "numReplicas": 1,
    "healthcheckPath": "/health",
    "healthcheckTimeout": 60,
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10,
    "overlapSeconds": 0,
    "drainingSeconds": 40
  }
}
