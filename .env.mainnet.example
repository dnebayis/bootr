# Bootr - Base MAINNET (8453) environment template.
# Copy into the Coolify application's environment (one set for every service, see docs/deploy/coolify.md
# section 3) or to a local `.env.mainnet`. Public mainnet values are filled in; every secret is a placeholder.
# Never commit a filled copy. Variable names mirror each app's config schema
# (apps/*/src/config.ts, apps/indexer/ponder.config.ts, apps/web). Empty strings count as unset.

# ---------------------------------------------------------------------------
# Chain (supervisor, indexer, web)
# ---------------------------------------------------------------------------
CHAIN_ID=8453
# CDP mainnet Node URL (the key is in the path: treat as a secret). Leave BASE_SEPOLIA_RPC_URL empty on mainnet.
BASE_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base/<CDP_NODE_KEY>
BASE_SEPOLIA_RPC_URL=

# Bootr contracts on Base mainnet (filled after `forge script script/Deploy.s.sol`; same values go into
# packages/shared/src/addresses.ts [8453].bootr and the NEXT_PUBLIC_* copies below).
BOOTR_LAUNCHER_ADDRESS=0x01f290cC464Ac6D167588b35A08305F58683526f
BOOTR_GUARDIAN_ADDRESS=0x799Ab875294E37839883D12084aB4BE3f7633630
# Block of the launcher deployment: first block the supervisor scans / the indexer backfills.
LAUNCHER_START_BLOCK=53433988
BOOTR_START_BLOCK=53433988
# Indexer only: every BootrLauncher ever used, `address@deployBlock,...`. Empty = the single pair above. When
# BootrLauncher is redeployed (the old one paused), set this to the old AND the new launcher and bump DATABASE_SCHEMA;
# the supervisor keeps following the new launcher alone through BOOTR_LAUNCHER_ADDRESS. Example for the switch:
# BOOTR_LAUNCHERS=0xD3CE024ddC37465510E6c9a1D7942f003338B1F3@53219209,0x<new launcher>@<new launcher deploy block>
BOOTR_LAUNCHERS=0xD3CE024ddC37465510E6c9a1D7942f003338B1F3@53219209,0x01f290cC464Ac6D167588b35A08305F58683526f@53433988
# Clanker path (docs/deploy/mainnet.md "Clanker path"; filled after `forge script script/DeployClankerLauncher.s.sol`).
# BOOTR_LAUNCHER_ADDRESS above becomes the v3.1 launcher; the gate is guardian.launcher; the Clanker launcher takes the
# same LaunchParams. Indexer sources: factory (TokenCreated), locker (ClaimedRewards), fee locker (ClaimTokens).
BOOTR_LAUNCH_GATE_ADDRESS=0x
BOOTR_CLANKER_LAUNCHER_ADDRESS=0x
CLANKER_START_BLOCK=
CLANKER_FACTORY_ADDRESS=0xE85A59c628F7d27878ACeB4bf3b35733630083a9
CLANKER_LOCKER_ADDRESS=0xffA37784D619F228D8B379d287a4D7282e500762
CLANKER_FEE_LOCKER_ADDRESS=0xF3622742b1E446D92e45E22923Ef11C2fcD55D68
# RWAGMI v3 launch stack on Base mainnet (verified on Basescan; token-launcher-sdk 0.3.0). Public addresses, not secrets.
# Services: supervisor = locker + launcher, indexer = launcher + locker + hook (+ dev buy), web = locker (NEXT_PUBLIC_ copy below).
RWAGMI_LAUNCHER_V3_ADDRESS=0xB205c9e7B43ca3a4aA99b82D449354CCB3294B20
RWAGMI_LOCKER_V3_ADDRESS=0xB205CE7CC26C35ed5E1f9655FF9d0115af4a1B20
RWAGMI_HOOK_V3_ADDRESS=0xB20B00367E37F826a0652c85a6DF375D784B20Ec
RWAGMI_DEV_BUY_V3_ADDRESS=0xb20A2dCBC4AA42474072381aEb52CbFc5C751B20
# The RWAGMI v3 launcher was created at block 52,861,401 (indexer default start for its events).
# Coins launched before 2026-10-29 are on Clanker v4 and keep their own fee split.

# Platform coin ($BOOTR) once launched (indexer fallback when the admin config has no bootToken).
BOOT_TOKEN_ADDRESS=

# ---------------------------------------------------------------------------
# Contract deployment (forge only; export per command, never on the server)
# ---------------------------------------------------------------------------
# DEPLOYER (~0.02 ETH). Broadcaster of Deploy.s.sol, DeployCallPolicy.s.sol, DeploySwapHelper.s.sol.
PRIVATE_KEY=0x<deployer private key>
# Final owner of AgentGuardian + BootrLauncher (must call acceptOwnership on both).
PLATFORM_ADMIN=0x
# Recipient of the platform fee slot (27% of the 1% swap fee on a standard launch, bps 2700 of 9000).
PLATFORM_RECIPIENT=0x
# Receiver of dormant sweeps; also the x402 pay-to and the wallet that launches $BOOTR.
PLATFORM_TREASURY=0x
MIN_FUEL_USDC=20000000
DORMANCY_PERIOD=7776000
MIN_PLATFORM_BPS=1000
# Only read by the original Deploy.s.sol; the RWAGMI-backed launcher charges the hook's static 1% (staticFee 10_000).
LP_FEE_BPS=10000
# BootrSwapHelper: Uniswap v3 WETH/USDC fee tier (0.05% pool 0xd0b53D9277642d899DF5C87A3966A349A798F224).
SWAP_POOL_FEE=500
# Optional overrides (defaults are the verified mainnet addresses in the scripts).
ETH_USD_FEED=
SWAP_ROUTER_02=
ERC8004_IDENTITY=
# Basescan key for `forge script --verify` (or use --verifier sourcify).
BASESCAN_API_KEY=
# Mainnet fork dry-run: `MAINNET_FORK=1 forge test --match-contract MainnetDryRun` (uses BASE_RPC_URL when set).
MAINNET_FORK=

# $BOOTR / test launches through script/Launch.s.sol (creator = PLATFORM_TREASURY for $BOOTR)
CREATOR_PRIVATE_KEY=0x<treasury private key>
LAUNCHER=0x
AGENT_NAME=Bootr
AGENT_SYMBOL=BOOT
AGENT_IMAGE=ipfs://
AGENT_URI=https://bootr.fun/agents/boot.json
AGENT_CONTEXT={"interface":"Bootr","platform":"bootr.fun"}
AGENT_METADATA={"description":"Bootr: the launchpad where every coin funds an agent.","socialMediaUrls":[{"platform":"x","url":"https://x.com/bootrfun"}],"auditUrls":[]}
AGENT_MODEL=claude-sonnet-4-5
BUYBACK=true
FUEL_USDC=20000000
DEV_BUY_WEI=0
SALT=
WORKER_HASH=
SUPERVISOR_KEY=0x

# ---------------------------------------------------------------------------
# Database (production: postgres://bootr:<generated>@postgres:5432/bootr, set by docker-compose.coolify.yml)
# ---------------------------------------------------------------------------
DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>
# Indexer uses its own variable (deliberately not DATABASE_URL) and a fresh schema per indexing code version.
INDEXER_DATABASE_URL=postgres://<user>:<password>@<host>:5432/<db>
DATABASE_SCHEMA=bootr_mainnet_v1

# ---------------------------------------------------------------------------
# Service-to-service keys (openssl rand -hex 32; all three distinct; fresh for mainnet)
# ---------------------------------------------------------------------------
SENDER_SERVICE_KEY=<64 hex chars>
SUPERVISOR_SERVICE_KEY=<64 hex chars>
INDEXER_SERVICE_KEY=<64 hex chars>

# ---------------------------------------------------------------------------
# supervisor (internal, one replica)
# ---------------------------------------------------------------------------
PORT=3004
SUPERVISOR_PORT=3004
# CDP mainnet bundler. No paymaster: gas is self-funded (the creator deposits the first gas at launch, then each
# agent unwraps its own WETH fees into gas under GAS_MIN_WEI). Enable-mode ops are self-bundled by the admin key.
BUNDLER_URL=https://api.developer.coinbase.com/rpc/v1/base/<CDP_BUNDLER_KEY>
PAYMASTER_URL=
GAS_MIN_WEI=200000000000000
GAS_TARGET_WEI=1000000000000000
ENABLE_MODE_BUNDLER_URL=
ENABLE_MODE_PAYMASTER_URL=
ENABLE_MODE_SELF_BUNDLE=true
ENABLE_MODE_MAX_PREFUND_WEI=5000000000000000
# Session signer: one EOA installed on every kernel (no ETH needed). Fresh key, never the Sepolia one.
SESSION_SIGNER_PRIVATE_KEY=0x<32-byte hex>
# Master secret for the per-agent x402 spender EOAs (must differ from the signer and the admin key).
SPENDER_MASTER_KEY=0x<32-byte hex>
# PLATFORM_ADMIN key (~0.05 ETH + 20 USDC): approveSessionKey / revokeSessionKey / self-bundled handleOps.
ADMIN_PRIVATE_KEY=0x<32-byte hex>
LAUNCH_LOG_CHUNK_BLOCKS=2000
SENDER_URL=http://sender:3002
INDEXER_URL=http://indexer:42069
INFERENCE_PROVIDER_URL=http://inference:3003
# USDC recipient of the inference relay = PLATFORM_TREASURY (the payer refuses any other payee).
INFERENCE_PAYTO_ADDRESS=0x
INFERENCE_TIMEOUT_MS=150000
INFERENCE_MAX_OUTPUT_TOKENS=1024
SUPERVISOR_TICK_MS=60000
MAX_AGENTS_PER_TICK=10
# Posting rhythm: original posts across all Bootr agents per 10-minute window, and UTC quiet hours (HH-HH; empty = none).
PLATFORM_POST_SLOTS_PER_10M=3
PLATFORM_QUIET_HOURS_UTC=
MAX_TOOL_STEPS=8
CLAIM_THRESHOLD_USD=5
FUEL_TARGET_USDC=20
# Max slippage vs Chainlink ETH/USD for BootrSwapHelper (on-chain cap 300); the dry-run swaps at 100.
SWAP_SLIPPAGE_BPS=100
CHAINLINK_MAX_AGE_SECONDS=3600
# Web research power (supervisor): Brave Search API. Free tier 2,000 queries/month at api.search.brave.com.
SEARCH_API_URL=https://api.search.brave.com/res/v1/web/search
SEARCH_API_KEY=
SESSION_KEY_VALIDITY_DAYS=30
SESSION_ROTATE_BEFORE_DAYS=3
SESSION_RATE_LIMIT_PER_HOUR=60
# 50 USDC per window per agent to its own spender (BootrCallPolicy SUM_PER_WINDOW, on-chain).
SESSION_USDC_TRANSFER_CAP=50000000
SESSION_USDC_WINDOW_SECONDS=86400
SPENDER_MIN_USDC=5
SPENDER_TARGET_USDC=20
SESSION_GAS_ALLOWANCE_WEI=100000000000000000
USER_OP_RECEIPT_TIMEOUT_MS=90000
BUILDER_CODES_ENABLED=true
BUILDER_CODES_URL=https://api.base.dev/v1/agents/builder-codes
LOG_LEVEL=info

# ---------------------------------------------------------------------------
# inference (internal)
# ---------------------------------------------------------------------------
INFERENCE_PORT=3003
OPENROUTER_API_KEY=<openrouter key with a spend limit>
X402_NETWORK=eip155:8453
X402_FACILITATOR_URL=https://api.cdp.coinbase.com/platform/v2/x402
# CDP secret API key of the mainnet project (required for the CDP facilitator).
CDP_API_KEY_ID=<cdp api key id>
CDP_API_KEY_SECRET=<cdp api key secret>
INFERENCE_X402_SCHEMES=exact
INFERENCE_PRICE_TABLE_JSON=
# Mainnet RPC for reconciliation of unknown rows (USDC authorizationState).
INFERENCE_RPC_URL=https://api.developer.coinbase.com/rpc/v1/base/<CDP_NODE_KEY>
INFERENCE_UPSTREAM_TIMEOUT_MS=120000
INFERENCE_PAYMENT_TIMEOUT_SECONDS=300

# ---------------------------------------------------------------------------
# sender (public: api.bootr.fun)
# ---------------------------------------------------------------------------
# PORT=3002 on the sender service (the compose file sets PORT per service)
X_CLIENT_ID=<production X app client id>
X_CLIENT_SECRET=<production X app client secret>
X_REDIRECT_URI=https://api.bootr.fun/oauth/callback
SENDER_OAUTH_RETURN_URL=https://bootr.fun/launch
# 32 bytes hex; rotating it orphans every stored X token.
SENDER_ENCRYPTION_KEY=<64 hex chars>
SENDER_RECONCILE_INTERVAL_MS=60000
SENDER_DEFAULT_POSTS_PER_DAY=24
SENDER_DEFAULT_MENTION_INTERVAL_SEC=300
SENDER_PUBLIC_RATE_LIMIT_PER_MIN=120
SENDER_TRUST_PROXY=1
X_API_BASE_URL=https://api.x.com
X_AUTHORIZE_URL=https://x.com/i/oauth2/authorize
X_TIMEOUT_MS=15000

# ---------------------------------------------------------------------------
# indexer (public: indexer.bootr.fun; PORT=42069 on that service)
# ---------------------------------------------------------------------------
INDEXER_MAX_RPS=25
INDEXER_SNAPSHOT_INTERVAL=
INDEXER_CORS_ORIGIN=https://bootr.fun
ADMIN_CONFIG_URL=https://bootr.fun/api/admin/config
# Chainlink ETH/USD on Base mainnet (default when empty): 0x71041dddad3595F9CEd3DcCFBe3D1F4b0a16Bb70
CHAINLINK_ETH_USD_FEED=
FUEL_SCAN_MAX_RANGE=5000

# ---------------------------------------------------------------------------
# web (public: bootr.fun) - runtime
# ---------------------------------------------------------------------------
# PORT=3000, HOSTNAME=0.0.0.0, ADMIN_CONFIG_PATH=/data/admin-config.json on the web service (compose)
SESSION_SECRET=<32+ chars>
ADMIN_CONSOLE_SLUG=<random slug without the "console-" prefix, treated as a secret; console at /console-<slug>/signin>
ADMIN_ADDRESSES=0x<admin wallet>,0x<admin wallet>
INFERENCE_URL=http://inference:3003
NODE_ENV=production

# web - build args (public, inlined into the browser bundle; changing any requires a rebuild)
NEXT_PUBLIC_CHAIN_ID=8453
NEXT_PUBLIC_SITE_URL=https://bootr.fun
NEXT_PUBLIC_INDEXER_URL=https://indexer.bootr.fun
NEXT_PUBLIC_SENDER_PUBLIC_URL=https://api.bootr.fun
# Public endpoint only (shipped to every browser), never the keyed CDP URL; empty = viem's default public RPC.
NEXT_PUBLIC_RPC_URL=https://mainnet.base.org
NEXT_PUBLIC_WC_PROJECT_ID=<walletconnect project id>
NEXT_PUBLIC_BUILDER_CODE=<base builder code of the platform wallet>
NEXT_PUBLIC_INFERENCE_URL=
# Trade link prefix; empty = LlamaSwap on Base (swap.defillama.com, ETH in, the coin out).
NEXT_PUBLIC_SWAP_LINK_BASE=
NEXT_PUBLIC_LAUNCHER_ADDRESS=0x01f290cC464Ac6D167588b35A08305F58683526f
# "Launch through Clanker" target (same LaunchParams ABI); empty until the Clanker launcher is deployed.
NEXT_PUBLIC_CLANKER_LAUNCHER_ADDRESS=
NEXT_PUBLIC_AGENT_GUARDIAN_ADDRESS=0x799Ab875294E37839883D12084aB4BE3f7633630
NEXT_PUBLIC_SUPERVISOR_SESSION_KEY=0x
NEXT_PUBLIC_BOOT_X_URL=https://x.com/bootrfun
NEXT_PUBLIC_WORKER_SOURCE_BASE=
NEXT_PUBLIC_USE_MOCK=

# IPFS (Pinata) for launch images: web only. Scoped key with pinFileToIPFS/upload rights; the
# gateway is the dedicated Pinata gateway origin (no trailing slash).
PINATA_JWT=<pinata scoped jwt>
NEXT_PUBLIC_IPFS_GATEWAY=https://<your-gateway>.mypinata.cloud

# Supervisor: launches created by this address run as the platform's own voice (@bootrfun). Same value as PLATFORM_TREASURY.
PLATFORM_TREASURY_ADDRESS=<platform treasury address>
