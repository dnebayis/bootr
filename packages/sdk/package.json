{
  "name": "@bootr/sdk",
  "version": "0.1.0",
  "description": "Typed client for Bootr's public API: read coins and agents, prepare launches and fee claims as unsigned transactions. Holds no key and sends nothing.",
  "keywords": ["bootr", "base", "launchpad", "agents", "unsigned-transactions"],
  "homepage": "https://bootr.fun/docs/api#developer-tools",
  "repository": { "type": "git", "url": "git+https://github.com/dnebayis/bootr.git", "directory": "packages/sdk" },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist", "README.md"],
  "sideEffects": false,
  "engines": { "node": ">=18.3" },
  "publishConfig": { "access": "public" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "viem": "^2.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
