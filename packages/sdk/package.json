{
  "name": "@bootrfun/sdk",
  "version": "0.3.0",
  "description": "Typed client for Bootr's public API: read coins and agents, prepare launches and fee claims as unsigned transactions, and the calls an AI client makes to run a coin's own agent. Holds no wallet key.",
  "license": "MIT",
  "keywords": [
    "bootr",
    "base",
    "launchpad",
    "agents",
    "unsigned-transactions"
  ],
  "homepage": "https://bootr.fun/docs/api#developer-tools",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dnebayis/bootr.git",
    "directory": "packages/sdk"
  },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18.3"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "prepare": "tsc -p tsconfig.build.json",
    "prepublishOnly": "tsc -p tsconfig.build.json"
  },
  "dependencies": {
    "viem": "^2.35.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "typescript": "^5.6.0",
    "vitest": "^3.0.0"
  }
}
