# ---- Bootr environment (never commit) ----
# Chain
CHAIN_ID=
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# Wallets
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
ADMIN_PRIVATE_KEY=
PLATFORM_TREASURY_ADDRESS=
PLATFORM_TREASURY_PRIVATE_KEY=
SESSION_SIGNER_ADDRESS=
SESSION_SIGNER_PRIVATE_KEY=

# Services
DATABASE_URL=
SENDER_SERVICE_KEY=
# sender: 32-byte hex key for AES-256-GCM token encryption (openssl rand -hex 32)
SENDER_ENCRYPTION_KEY=
# sender: optional; browser is redirected here after X OAuth (unset = JSON response)
SENDER_OAUTH_RETURN_URL=
SESSION_SECRET=
ADMIN_ADDRESSES=
ADMIN_CONSOLE_SLUG=

# External (fill in)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3002/oauth/callback
BASESCAN_API_KEY=
# x402 facilitator. Empty = https://x402.org/facilitator on Base Sepolia and the CDP facilitator on Base.
# With a CDP API key (CDP_API_KEY_ID/SECRET) set it to https://api.cdp.coinbase.com/platform/v2/x402 on Sepolia too
# (first 1,000 settlements/month free, verification free, same service in production).
X402_FACILITATOR_URL=
INFERENCE_PROVIDER_URL=
SWAP_LINK_BASE=

# Inference relay (apps/inference); also uses DATABASE_URL and X402_FACILITATOR_URL above
INFERENCE_PORT=
OPENROUTER_API_KEY=
X402_NETWORK=
INFERENCE_PAYTO_ADDRESS=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
INFERENCE_X402_SCHEMES=
INFERENCE_PRICE_TABLE_JSON=
INFERENCE_RPC_URL=
INFERENCE_UPSTREAM_TIMEOUT_MS=
INFERENCE_PAYMENT_TIMEOUT_SECONDS=

# Web app (apps/web) - public, inlined into the browser bundle at build time
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_USE_MOCK=
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_RPC_URL=
# Base Builder Code (ERC-8021) of the platform wallet; appended to launch transactions sent from the web. Register one with POST https://api.base.dev/v1/agents/builder-codes {walletAddress}.
NEXT_PUBLIC_BUILDER_CODE=
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_INFERENCE_URL=
NEXT_PUBLIC_SENDER_PUBLIC_URL=
NEXT_PUBLIC_SWAP_LINK_BASE=
NEXT_PUBLIC_LAUNCHER_ADDRESS=
NEXT_PUBLIC_AGENT_GUARDIAN_ADDRESS=
NEXT_PUBLIC_SUPERVISOR_SESSION_KEY=
NEXT_PUBLIC_BOOT_X_URL=
NEXT_PUBLIC_WORKER_SOURCE_BASE=

# INDEXER_MAX_RPS caps Ponder's JSON-RPC rate across all urls (default 50); use ~25 when sharing a CDP key with the supervisor.
INDEXER_MAX_RPS=25
# Indexer (apps/indexer); also uses CHAIN_ID, BASE_*_RPC_URL (the indexer accepts a comma-separated list of urls and load-balances) and SENDER_SERVICE_KEY above
BOOTR_LAUNCHER_ADDRESS=
BOOTR_GUARDIAN_ADDRESS=
BOOTR_START_BLOCK=
# optional: Postgres for the indexer (empty = PGlite in apps/indexer/.ponder); `ponder start` also needs DATABASE_SCHEMA
INDEXER_DATABASE_URL=
DATABASE_SCHEMA=
# optional: blocks between snapshots (default ~60 s: 30 on Base, 300 on Base Sepolia)
INDEXER_SNAPSHOT_INTERVAL=
# optional: web admin config endpoint, e.g. https://bootr.fun/api/admin/config
ADMIN_CONFIG_URL=
BOOT_TOKEN_ADDRESS=
# comma-separated CORS origins for the indexer API (empty = any origin, dev only)
NEXT_PUBLIC_WEB_ORIGIN=
CHAINLINK_ETH_USD_FEED=
FUEL_SCAN_MAX_RANGE=

# Supervisor (apps/supervisor); also uses CHAIN_ID, BASE_*_RPC_URL, DATABASE_URL, SESSION_SIGNER_PRIVATE_KEY,
# ADMIN_PRIVATE_KEY (guardian owner, only for approveSessionKey/revokeSessionKey), SENDER_SERVICE_KEY,
# INFERENCE_PROVIDER_URL and INFERENCE_PAYTO_ADDRESS above
# ERC-4337 bundler. CDP Paymaster gives one endpoint for bundler + paymaster (ERC-7677) on Base and Base Sepolia;
# ZeroDev / Pimlico work too. With CDP, put the same URL in BUNDLER_URL and PAYMASTER_URL and allow-list
# the Bootr contracts in the CDP paymaster policy so agent kernels never need ETH.
BUNDLER_URL=
PAYMASTER_URL=
# Session-key install/rotation (enable mode) needs a bundler that tolerates module `onInstall` during validation;
# strict ERC-7562 bundlers (CDP) reject it. Point this at ZeroDev and keep CDP in BUNDLER_URL for everything else.
ENABLE_MODE_BUNDLER_URL=
ENABLE_MODE_PAYMASTER_URL=
BOOTR_LAUNCHER_ADDRESS=
BOOTR_GUARDIAN_ADDRESS=
LAUNCHER_START_BLOCK=
# Block range per eth_getLogs call when scanning AgentLaunched (public Base RPCs cap it at 200)
LAUNCH_LOG_CHUNK_BLOCKS=200
# Base Builder Codes (ERC-8021): one code per agent kernel, registered at onboarding and appended to every session userOp.
BUILDER_CODES_ENABLED=true
BUILDER_CODES_URL=https://api.base.dev/v1/agents/builder-codes
SENDER_URL=
INDEXER_URL=
SUPERVISOR_PORT=
SUPERVISOR_SERVICE_KEY=
SUPERVISOR_TICK_MS=
MAX_AGENTS_PER_TICK=
MAX_TOOL_STEPS=
CLAIM_THRESHOLD_USD=
FUEL_TARGET_USDC=
SWAP_ROUTE=
SWAP_SLIPPAGE_BPS=
SEARCH_API_URL=
SEARCH_API_KEY=
SESSION_KEY_VALIDITY_DAYS=
SESSION_ROTATE_BEFORE_DAYS=
SESSION_RATE_LIMIT_PER_HOUR=
SESSION_USDC_TRANSFER_CAP=
SESSION_GAS_ALLOWANCE_WEI=
SESSION_1271_CALLERS=any
INFERENCE_TIMEOUT_MS=
INFERENCE_MAX_OUTPUT_TOKENS=
USER_OP_RECEIPT_TIMEOUT_MS=

BOOTR_BURNER_IMPL_ADDRESS=
PORT=