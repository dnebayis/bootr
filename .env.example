# ---- Bootr environment (never commit) ----
# Chain
CHAIN_ID=
BASE_SEPOLIA_RPC_URL=
BASE_RPC_URL=

# Wallets
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
ADMIN_ADDRESS=
ADMIN_PRIVATE_KEY=
PLATFORM_TREASURY_ADDRESS=
PLATFORM_TREASURY_PRIVATE_KEY=
SESSION_SIGNER_ADDRESS=
SESSION_SIGNER_PRIVATE_KEY=

# Services
DATABASE_URL=
# Per-service HMAC keys, 32+ chars each (openssl rand -hex 32). SENDER: sender internal API + OAuth start (held by sender, supervisor, web).
# INDEXER: indexer /internal/agent/:kernel/social + the indexer's admin-config GET to the web (held by indexer, supervisor, web).
# SUPERVISOR: supervisor admin API only.
SENDER_SERVICE_KEY=
INDEXER_SERVICE_KEY=
# sender: 32-byte hex key for AES-256-GCM token encryption (openssl rand -hex 32)
SENDER_ENCRYPTION_KEY=
# sender: optional; browser is redirected here after X OAuth (unset = JSON response)
SENDER_OAUTH_RETURN_URL=
SESSION_SECRET=
ADMIN_ADDRESSES=
# Random, at least 8 chars, WITHOUT the "console-" prefix: the console is served at /console-<slug>/signin
ADMIN_CONSOLE_SLUG=

# External (fill in)
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3002/oauth/callback
BASESCAN_API_KEY=
# x402 facilitator. Empty = https://x402.org/facilitator on Base Sepolia and the CDP facilitator on Base.
# With a CDP API key (CDP_API_KEY_ID/SECRET) set it to https://api.cdp.coinbase.com/platform/v2/x402 on Sepolia too
# (first 1,000 settlements/month free, verification free, same service in production).
X402_FACILITATOR_URL=
INFERENCE_PROVIDER_URL=
SWAP_LINK_BASE=

# Inference relay (apps/inference); also uses DATABASE_URL and X402_FACILITATOR_URL above
INFERENCE_PORT=
OPENROUTER_API_KEY=
X402_NETWORK=
INFERENCE_PAYTO_ADDRESS=
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=
INFERENCE_X402_SCHEMES=
INFERENCE_PRICE_TABLE_JSON=
INFERENCE_RPC_URL=
INFERENCE_UPSTREAM_TIMEOUT_MS=
INFERENCE_PAYMENT_TIMEOUT_SECONDS=

# Web app (apps/web) - public, inlined into the browser bundle at build time
NEXT_PUBLIC_CHAIN_ID=
NEXT_PUBLIC_INDEXER_URL=
NEXT_PUBLIC_USE_MOCK=
NEXT_PUBLIC_WC_PROJECT_ID=
NEXT_PUBLIC_RPC_URL=
# Base Builder Code (ERC-8021) of the platform wallet; appended to launch transactions sent from the web. Register one with POST https://api.base.dev/v1/agents/builder-codes {walletAddress}.
NEXT_PUBLIC_BUILDER_CODE=
# Token images are pinned to IPFS through Pinata (server-side JWT with org:files:write); the public gateway is rate-limited, use a dedicated one in production.
PINATA_JWT=
NEXT_PUBLIC_IPFS_GATEWAY=https://gateway.pinata.cloud
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_INFERENCE_URL=
NEXT_PUBLIC_SENDER_PUBLIC_URL=
NEXT_PUBLIC_SWAP_LINK_BASE=
NEXT_PUBLIC_LAUNCHER_ADDRESS=
# RWAGMI v3 LP locker (reward ledger the token page reads launchInfo from). Base mainnet only: v3 has no Sepolia deployment.
NEXT_PUBLIC_AGENT_GUARDIAN_ADDRESS=
NEXT_PUBLIC_SUPERVISOR_SESSION_KEY=
NEXT_PUBLIC_BOOT_X_URL=https://x.com/bootrfun
NEXT_PUBLIC_WORKER_SOURCE_BASE=
# web (server): absolute path of the admin config JSON file; point it at a persistent volume in production
# (e.g. /data/admin-config.json in the container, the Docker image default). Empty = apps/web/data/admin-config.json
ADMIN_CONFIG_PATH=

# INDEXER_MAX_RPS caps Ponder's JSON-RPC rate across all urls (default 50); use ~25 when sharing a CDP key with the supervisor.
INDEXER_MAX_RPS=25
# Indexer (apps/indexer); also uses CHAIN_ID, BASE_*_RPC_URL (the indexer accepts a comma-separated list of urls and load-balances) and SENDER_SERVICE_KEY above
# Every BootrLauncher the indexer follows, comma-separated `address@deployBlock` (a replaced launcher stays listed so its
# coins stay indexed). When empty, the single BOOTR_LAUNCHER_ADDRESS + BOOTR_START_BLOCK pair below is used. Adding an
# entry needs a new DATABASE_SCHEMA (backfill): apps/indexer/README.md "Adding a launcher".
BOOTR_LAUNCHERS=
BOOTR_LAUNCHER_ADDRESS=
BOOTR_GUARDIAN_ADDRESS=
BOOTR_START_BLOCK=
# RWAGMI v3 launch stack (Base mainnet only: v3 has no Base Sepolia deployment, so these stay empty on Sepolia and a
# local stack points at a Base mainnet fork, see docs/deploy/coolify.md section 8). The indexer reads all three; the
# RWAGMI_DEV_BUY_V3_ADDRESS is only needed where dev buys are decoded. Mainnet values: .env.mainnet.example.
RWAGMI_LAUNCHER_V3_ADDRESS=
RWAGMI_LOCKER_V3_ADDRESS=
RWAGMI_HOOK_V3_ADDRESS=
RWAGMI_DEV_BUY_V3_ADDRESS=
# optional: Postgres for the indexer (empty = PGlite in apps/indexer/.ponder); `ponder start` also needs DATABASE_SCHEMA
INDEXER_DATABASE_URL=
DATABASE_SCHEMA=
# optional: blocks between snapshots (default ~60 s: 30 on Base, 300 on Base Sepolia)
INDEXER_SNAPSHOT_INTERVAL=
# optional: web admin config endpoint, e.g. https://bootr.fun/api/admin/config
ADMIN_CONFIG_URL=
BOOT_TOKEN_ADDRESS=
# comma-separated CORS origins for the indexer API. Empty = https://bootr.fun (plus any localhost origin when
# NODE_ENV is not production); `*` = any origin. NEXT_PUBLIC_WEB_ORIGIN is the older name, used only when this is empty.
INDEXER_CORS_ORIGIN=
NEXT_PUBLIC_WEB_ORIGIN=
CHAINLINK_ETH_USD_FEED=
FUEL_SCAN_MAX_RANGE=

# Supervisor (apps/supervisor); also uses CHAIN_ID, BASE_*_RPC_URL, DATABASE_URL, SESSION_SIGNER_PRIVATE_KEY,
# ADMIN_PRIVATE_KEY (guardian owner, only for approveSessionKey/revokeSessionKey), SENDER_SERVICE_KEY,
# INFERENCE_PROVIDER_URL and INFERENCE_PAYTO_ADDRESS above
# ERC-4337 bundler (CDP, ZeroDev or Pimlico). Gas is self-funded by default: PAYMASTER_URL stays empty, every kernel
# pays its own userOp prefund from its EntryPoint deposit + ETH. The creator deposits the first gas from the launch
# form (or anyone later from the token page) and the fee policy unwraps the kernel's WETH fees into ETH whenever gas
# drops under GAS_MIN_WEI (apps/supervisor/src/gas.ts). The platform pays no agent gas. Set an ERC-7677
# PAYMASTER_URL only to sponsor every op instead (then allow-list the Bootr contracts in its policy).
BUNDLER_URL=
PAYMASTER_URL=
# Self-funded gas (wei): unwrap threshold, unwrap target.
GAS_MIN_WEI=200000000000000
GAS_TARGET_WEI=1000000000000000
# Session-key install/rotation (enable mode) needs a bundler that tolerates module `onInstall` during validation;
# strict ERC-7562 bundlers (CDP) reject it. Point this at ZeroDev and keep CDP in BUNDLER_URL for everything else.
ENABLE_MODE_BUNDLER_URL=
ENABLE_MODE_PAYMASTER_URL=
# true = the admin signer sends enable-mode userOps itself via EntryPoint.handleOps (no bundler needed; kernel pays the prefund in ETH).
ENABLE_MODE_SELF_BUNDLE=false
# Max wei the admin deposits into the EntryPoint for a kernel's prefund before a self-bundled op (default 0.005 ETH).
ENABLE_MODE_MAX_PREFUND_WEI=5000000000000000
BOOTR_LAUNCHER_ADDRESS=
BOOTR_GUARDIAN_ADDRESS=
LAUNCHER_START_BLOCK=
# RWAGMI v3 (Base mainnet only): the supervisor claims creator-reward WETH from the locker and decodes the launch from the launcher.
# RWAGMI_LAUNCHER_V3_ADDRESS / RWAGMI_LOCKER_V3_ADDRESS are shared with the indexer block above.
# Block range per eth_getLogs call when scanning AgentLaunched (public Base RPCs cap it at 200)
LAUNCH_LOG_CHUNK_BLOCKS=200
# Base Builder Codes (ERC-8021): one code per agent kernel, registered at onboarding and appended to every session userOp.
BUILDER_CODES_ENABLED=true
BUILDER_CODES_URL=https://api.base.dev/v1/agents/builder-codes
SENDER_URL=
INDEXER_URL=
SUPERVISOR_PORT=
SUPERVISOR_SERVICE_KEY=
SUPERVISOR_TICK_MS=
MAX_AGENTS_PER_TICK=
MAX_TOOL_STEPS=
CLAIM_THRESHOLD_USD=
FUEL_TARGET_USDC=
SWAP_SLIPPAGE_BPS=
SEARCH_API_URL=
SEARCH_API_KEY=
SESSION_KEY_VALIDITY_DAYS=
SESSION_ROTATE_BEFORE_DAYS=
SESSION_RATE_LIMIT_PER_HOUR=
# Per-agent x402 spender EOAs are derived from this 32-byte key (openssl rand -hex 32); must differ from the session signer and admin keys.
SPENDER_MASTER_KEY=
# Spender float: top up from the kernel when below MIN, up to TARGET; SESSION_USDC_TRANSFER_CAP is the total per window.
SPENDER_MIN_USDC=5
SPENDER_TARGET_USDC=20
SESSION_USDC_WINDOW_SECONDS=86400
# Chainlink ETH/USD max age for swap floors.
CHAINLINK_MAX_AGE_SECONDS=3600
SESSION_USDC_TRANSFER_CAP=
SESSION_GAS_ALLOWANCE_WEI=
SESSION_1271_CALLERS=any
INFERENCE_TIMEOUT_MS=
INFERENCE_MAX_OUTPUT_TOKENS=
USER_OP_RECEIPT_TIMEOUT_MS=

BOOTR_BURNER_IMPL_ADDRESS=
PORT=